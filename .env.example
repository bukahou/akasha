# Akasha 环境变量示例 — 复制为本地 env 文件后填入真实值 (真实值永不入库)
#
#   cp .env.example .env && vim .env && set -a && source .env && set +a

# ---- 存储 (必填, 无默认值) ----
AKASHA_DB_DSN="user:password@tcp(127.0.0.1:3306)/akasha?charset=utf8mb4&parseTime=True&loc=Local"

# ---- 服务 ----
AKASHA_ADDR=":9100"
# 协议层身份, 上线后不可更改; 生产填 https://your-domain
AKASHA_ISSUER="http://localhost:9100"

# ---- 签名 ----
# 生成: ./scripts/genkey.sh ./signing-key.pem
AKASHA_SIGNING_KEY_PATH="./signing-key.pem"

# ---- 会话 ----
# 生产必须 true (https 下 cookie 才不会被明文窃取)
AKASHA_COOKIE_SECURE="false"

# ---- TTL (可选, 留空用默认) ----
# AKASHA_ID_TOKEN_TTL="10m"
# AKASHA_ACCESS_TOKEN_TTL="1h"
# AKASHA_REFRESH_TTL="720h"
# AKASHA_SESSION_TTL="720h"
# AKASHA_AUTH_CODE_TTL="60s"
