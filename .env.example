# Akasha 环境变量示例 — 复制为本地 env 文件后填入真实值 (真实值永不入库)
#
#   cp .env.example .env && vim .env && set -a && source .env && set +a

# ---- 存储 (必填, 无默认值) ----
AKASHA_DB_DSN="user:password@tcp(127.0.0.1:3306)/akasha?charset=utf8mb4&parseTime=True&loc=Local"

# ---- 服务 ----
AKASHA_ADDR=":9100"
# 协议层身份, 上线后不可更改; 生产填 https://your-domain
AKASHA_ISSUER="http://localhost:9100"

# ---- 签名 ----
# 生成: ./scripts/genkey.sh ./signing-key.pem
AKASHA_SIGNING_KEY_PATH="./signing-key.pem"

# ---- pairwise sub 密钥 (必填, 无默认值) ----
# 每个下游应用拿到的 sub 由 HMAC-SHA256(此密钥, client_id \0 internal_id) 算出。
#
# ⚠️ 比签名私钥更不能丢: 私钥丢了重签一把即可 (旧 token 自然过期);
#    这个盐丢了, 所有下游算出的 sub 全变, 各应用里的用户关联【永久失效
#    且无法重算】, 只能让全体用户重新绑定。务必纳入备份。
# 生成: openssl rand -hex 32
AKASHA_PAIRWISE_SALT=""

# ---- 上游联邦: Google (必填, 无默认值) ----
# 无密码定案后联邦是唯一认证入口, 缺这两项服务不会启动。
# GCP 控制台 → Google Auth Platform → 客户端 → 已获授权的重定向 URI 需包含:
#   http://localhost:9100/federation/google/callback
#   https://your-domain/federation/google/callback
AKASHA_GOOGLE_CLIENT_ID=""
AKASHA_GOOGLE_CLIENT_SECRET=""

# ---- Cookie ----
# 生产必须 true。akasha 无登录态 cookie, 这里管的是联邦往返期间的状态 cookie
AKASHA_COOKIE_SECURE="false"

# ---- TTL (可选, 留空用默认) ----
# AKASHA_ID_TOKEN_TTL="10m"
# AKASHA_ACCESS_TOKEN_TTL="1h"
# AKASHA_REFRESH_TTL="720h"
# AKASHA_AUTH_CODE_TTL="60s"
# 一次联邦往返的有效期 (含用户在上游输密码/过 MFA 的时间)
# AKASHA_FEDERATION_TTL="10m"
